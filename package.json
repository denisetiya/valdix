{
  "name": "valdix",
  "version": "0.6.0",
  "description": "Zero-dependency TypeScript-first schema validation with 17 built-in locales and casual end-user-ready error messages. About 1KB gzipped.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/postbuild-cjs.mjs",
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "npm run test:esm && npm run test:cjs",
    "test:esm": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/valdix.test.mjs tests/valdix-v2.test.mjs tests/v0.4.test.mjs tests/v0.6-locales.test.mjs tests/v0.7.test.mjs tests/function.test.mjs tests/tree-shake.test.mjs",
    "test:cjs": "node tests/cjs.test.cjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "bench": "node benchmark/run.mjs",
    "bench:compare": "node benchmark/compare.mjs",
    "size": "node scripts/size.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview"
  },
  "keywords": [
    "validation",
    "schema",
    "typescript",
    "zod",
    "i18n",
    "multilingual",
    "zero-dependency",
    "standard-schema"
  ],
  "author": "Deni Setiya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisetiya/valdix.git"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
